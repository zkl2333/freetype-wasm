{
  "name": "@zkl2333/freetype-wasm",
  "version": "2.14.3",
  "type": "module",
  "description": "A memory-growable FreeType WebAssembly build with the complete public C API for Node.js, browsers, and workers.",
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs"
    },
    "./freetype.mjs": "./dist/freetype.mjs",
    "./freetype.wasm": "./dist/freetype.wasm",
    "./offsets.mjs": "./dist/offsets.mjs",
    "./struct-offsets.json": "./dist/struct-offsets.json"
  },
  "files": [
    "dist",
    "README.md",
    "README.zh-CN.md",
    "LICENSE"
  ],
  "scripts": {
    "build:docker": "docker build -t freetype-wasm . && docker run --rm -v \"$PWD/dist:/src/dist\" freetype-wasm",
    "test": "node test/test.mjs",
    "check:package": "node scripts/check-package.mjs",
    "prepublishOnly": "npm run check:package"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "registry": "https://registry.npmjs.org/"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zkl2333/freetype-wasm.git"
  },
  "homepage": "https://github.com/zkl2333/freetype-wasm#readme",
  "bugs": {
    "url": "https://github.com/zkl2333/freetype-wasm/issues"
  },
  "keywords": [
    "freetype",
    "wasm",
    "webassembly",
    "font",
    "glyph",
    "mono",
    "bitmap",
    "cjk",
    "woff2",
    "rasterize"
  ]
}
